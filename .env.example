# Copy to .env for local runs outside Docker. Real environments (Render) set these
# as environment variables instead; never commit a real .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/products
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Directory shared by the web process and the Celery worker for uploaded CSVs
UPLOAD_DIR=/tmp/uploads
